# ─── GitHub API ──────────────────────────────────────────────────────────────
# Personal access token for higher rate limits. Optional for public repos.
# Generate at: https://github.com/settings/tokens (read-only public_repo scope)
# NEVER commit the actual token.
GITHUB_TOKEN=

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Open-Source Contribution Opportunity Finder
APP_VERSION=0.1.0
DEBUG=false

# ─── GitHub Client Tuning ────────────────────────────────────────────────────
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_CONCURRENT_REQUESTS=5
GITHUB_REQUEST_TIMEOUT_SECONDS=30
GITHUB_MAX_PAGES_PER_QUERY=10
GITHUB_RESULTS_PER_PAGE=30

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=data/opportunities.db
DATABASE_BUSY_TIMEOUT_MS=5000

# ─── Server ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ─── Scoring ─────────────────────────────────────────────────────────────────
SCORING_CONFIG_VERSION=v1.0.0
